# Local development settings for timesheet-bot.
#
# Copy this file to .env at the REPOSITORY ROOT, from the root:
#
#   cp .env.example .env && chmod 600 .env
#
# (or, from services/timesheet-core: cp .env.example ../../.env). A .env inside
# services/timesheet-core is read by nothing. The root and service copies of this file are
# identical; change both together.
#
# .env is gitignored, written by the owner only, and never committed.
# Tokens: fill in your local .env (gitignored, written by the owner only) or export in
# ~/.zshrc; never commit. Never put a value in this .env.example file.
# If a token ever leaks (chat, log, commit), rotate it.
#
# Who reads .env:
#   - `make -C services/timesheet-core run ARGS="..."` and `make test-int` load it. A variable
#     already exported in your shell wins over the value here.
#   - `docker compose` reads it for ${VAR} interpolation (the shell wins), and the app service
#     also loads it with `env_file` (optional). `environment:` wins over `env_file`.
# Go has no built-in .env loading. See docs/operations/configuration.md.

# --- Local database (docker compose up -d db) -------------------------------------------
# Local-only defaults that match the db service in docker-compose.yml. Not secrets.
# Used by `make run`, every command except `plan --dry-run`. Inside compose, the app service
# sets its own DATABASE_URL (host db).
DATABASE_URL=postgres://timesheet:timesheet@localhost:5432/timesheet?sslmode=disable
# Used by `make test-int` only.
TEST_DATABASE_URL=postgres://timesheet:timesheet@localhost:5432/timesheet?sslmode=disable

# --- Non-secret runtime settings ---------------------------------------------------------
# None. Timezone, account IDs, caps, submit targets, the Tempo and Mavenlink URLs and the
# Mavenlink auth mode live in services/timesheet-core/config/config.yaml.

# --- Tokens ------------------------------------------------------------------------------
# Leave empty here. Fill in your local .env (gitignored, written by the owner only) or
# export in ~/.zshrc; never commit. An empty KEY= never blanks a token exported in the shell.

# Slack user token. Required by every command except `migrate`.
SLACK_USER_TOKEN=
# Jira site, for example https://<site>.atlassian.net. Not secret. Required by every command except `migrate`.
JIRA_BASE_URL=
# Jira account email, for example <name>@<company>.com. Not secret. Required by every command except `migrate`.
JIRA_EMAIL=
# Jira API token. Required by every command except `migrate`.
JIRA_API_TOKEN=
# Tempo API token. Required by `submit` only, when submit_targets has tempo.
TEMPO_API_TOKEN=
# Mavenlink OAuth token. Required by `submit` only, when submit_targets has mavenlink and mavenlink.auth is bearer.
MAVENLINK_API_TOKEN=
# Mavenlink browser session: the full raw Cookie header from DevTools; expires with the SSO session.
# Required by `submit` only, when submit_targets has mavenlink and mavenlink.auth is cookie.
MAVENLINK_SESSION_COOKIE=
